---
import Button from '../components/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import FeatureCard from '../components/FeatureCard.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import InfoNote from '../components/InfoNote.astro';
import Media from '../components/Media.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import RouteMap from '../components/RouteMap.astro';
import TrustList from '../components/TrustList.astro';
import { getFamilyGroups } from '../lib/catalog';
import { contact } from '../lib/contact';
import { getFamilyVisual } from '../lib/family-visuals';
import { photos } from '../lib/photos';

const groups = await getFamilyGroups();
const heroPhoto = photos.hero;
const deliveryService = groups
  .flatMap(({ services }) => services)
  .find((service) => service.data.name === 'Servicio de reparto');
if (!deliveryService) throw new Error('Servicio de reparto not found');
---

<BaseLayout
  title="Logispack | Logística, maquila y personal especializado"
  description="Servicios logísticos, maquila y personal especializado para empresas que no pueden detener su operación."
>
  <section class="hero">
    <div class:list={['container', { 'has-media': Boolean(heroPhoto) }]}>
      <div class="hero__body">
        <p class="eyebrow">
          Servicios logísticos y maquila · Certificación REPSE
        </p>
        <h1>
          Su operación logística, <span>resuelta de principio a fin</span>
        </h1>
        <p class="lead">
          Personal certificado, maquila con acabado premium y almacenamiento
          controlado. Su producto sale a tiempo y llega listo para exhibirse.
        </p>
        <div class="actions">
          <Button href={contact.whatsappUrl}>{contact.whatsappLabel}</Button>
          <Button href="/servicios/" variant="outline">
            Ver servicios
          </Button>
        </div>
        <InfoNote>
          Respuesta el mismo día hábil. Cotización sin compromiso.
        </InfoNote>
      </div>
      {heroPhoto && (
        <Media
          {...heroPhoto}
          loading="eager"
          fetchpriority="high"
          sizes="(min-width: 600px) 600px, 100vw"
          widths={[600, 1200]}
        />
      )}
    </div>
  </section>

  <section class="section" id="familias" aria-labelledby="familias-title">
    <div class="container">
      <h2 id="familias-title">Nuestros servicios</h2>
      <div class="feature-grid">
        {groups.map(({ family, services }) => (
          <FeatureCard
            title={family.data.name}
            visual={getFamilyVisual(family.id)}
          >
            <ul class="feature__links">
              {services.map((service) => (
                <li>
                  <a class="feature-link" href={`/servicios/${service.id}/`}>
                    {service.data.name}
                    <Icon name="caret-right" size="sm" />
                  </a>
                </li>
              ))}
            </ul>
          </FeatureCard>
        ))}
      </div>
    </div>
  </section>

  <RouteMap
    class="section--subtle"
    serviceHref={`/servicios/${deliveryService.id}/`}
  />

  <section class="section" id="confianza" aria-labelledby="confianza-title">
    <div class="container">
      <h2 id="confianza-title">Por qué Logispack</h2>
      <TrustList />
    </div>
  </section>

  <section
    class="section section--subtle"
    id="proceso"
    aria-labelledby="proceso-title"
  >
    <div class="container">
      <h2 id="proceso-title">Cómo trabajamos</h2>
      <ProcessSteps />
    </div>
  </section>

  <section class="section" id="faq-preview" aria-labelledby="faq-preview-title">
    <div class="container">
      <h2 id="faq-preview-title">Preguntas frecuentes</h2>
      <FaqList limit={3} />
      <p class="more">
        <a href="/preguntas-frecuentes/">Ver todas las preguntas</a>
      </p>
    </div>
  </section>

  <CtaBand id="contacto-cta" />
</BaseLayout>
