---
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'outline';
}

const { href, variant = 'primary' } = Astro.props;
---

<a
  class:list={['button', { 'button--outline': variant === 'outline' }]}
  href={href}
>
  <span>
    <slot />
  </span>
  <Icon name="caret-right" size="sm" />
</a>
