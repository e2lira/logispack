---
import Button from './Button.astro';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logispack-logo.svg';
import { contact } from '../lib/contact';
import { navCurrent, navItems } from '../lib/nav';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container">
    <a class="brand" href="/">
      <Image
        src={logo}
        alt="Logispack Capital Humano, inicio"
        width={175}
        height={60}
        loading="eager"
      />
    </a>
    <Button href={contact.whatsappUrl}>{contact.whatsappLabel}</Button>
    <nav class="site-nav" aria-label="Principal">
      <ul>
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={navCurrent(item.href, currentPath)}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
