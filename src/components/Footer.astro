---
import Button from './Button.astro';
import { Image } from 'astro:assets';
import logoWhite from '../assets/brand/logispack-logo-white.svg';
import { contact } from '../lib/contact';
---

<footer class="site-footer" data-surface="inverse">
  <div class="container">
    <div>
      <Image
        src={logoWhite}
        alt="Logispack Capital Humano"
        width={187}
        height={64}
        class="footer-logo"
        loading="lazy"
      />
      <p>{contact.descriptor}</p>
    </div>
    <div>
      <h2>Contacto</h2>
      <ul>
        {contact.phones.map((phone) => (
          <li>
            {phone.label}: <a href={phone.href}>{phone.display}</a>
          </li>
        ))}
        <li>
          Correo: <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </li>
      </ul>
      <p>
        <Button href={contact.whatsappUrl}>{contact.whatsappLabel}</Button>
      </p>
    </div>
    <div>
      <h2>Ubicación y horario</h2>
      <address>{contact.address}</address>
      <p>{contact.hours}</p>
    </div>
    <p class="legal">{contact.legal}</p>
  </div>
</footer>
