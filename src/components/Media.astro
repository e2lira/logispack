---
import { Picture } from 'astro:assets';
import { resolveMedia, type MediaInput } from '../lib/media';

interface Props extends MediaInput {
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const { loading = 'lazy', fetchpriority, ...input } = Astro.props;
const media = resolveMedia(input);
---

<figure class="media" style={`--media-ratio: ${media.ratio}`}>
  <Picture
    src={media.image}
    alt={media.alt}
    width={media.width}
    height={media.height}
    sizes={media.sizes}
    {...(media.widths ? { widths: media.widths } : {})}
    formats={media.formats}
    loading={loading}
    fetchpriority={fetchpriority}
  />
</figure>
