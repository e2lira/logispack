---
import { Picture } from 'astro:assets';
import { resolveMedia, type MediaInput } from '../lib/media';

interface Props extends MediaInput {
  loading?: 'eager' | 'lazy';
}

const { loading = 'lazy', ...input } = Astro.props;
const media = resolveMedia(input);
---

<figure class="media" style={`--media-ratio: ${media.ratio}`}>
  <Picture
    src={media.image}
    alt={media.alt}
    width={media.width}
    height={media.height}
    sizes={media.sizes}
    formats={media.formats}
    loading={loading}
  />
</figure>
